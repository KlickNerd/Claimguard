# ClaimGuard – Root-Umgebung
# Kopiere nach .env und passe Werte an. Nur für lokale Entwicklung.
# Für apps/web und apps/api existieren zusätzliche .env.example in den jeweiligen Ordnern.

# ==== Lokale Infrastruktur (docker-compose) ====
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
EMBEDDING_SERVICE_URL=http://localhost:8080

# ==== Supabase (gemeinsam Frontend + Backend) ====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ==== Anthropic ====
ANTHROPIC_API_KEY=

# ==== Stripe ====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ==== Sentry (später) ====
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ==== Feature-Flags ====
ENVIRONMENT=development
