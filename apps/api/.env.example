# ClaimGuard API – Python Backend
ENVIRONMENT=development

# Anthropic
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://...

# Lokale Services (docker compose up -d)
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
KB_DB_URL=postgresql://claimguard:claimguard@localhost:5432/claimguard

# Embedding-Modell (in-process via sentence-transformers, siehe ADR-0006)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS
CORS_ORIGINS=["http://localhost:3000"]
