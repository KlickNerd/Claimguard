# Supabase (required for PROJ-1 auth flow).
# Get both values from Supabase Dashboard -> Project Settings -> API.
# NEXT_PUBLIC_SUPABASE_URL is your project URL.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the "publishable" / "anon" key -
# safe to ship in the browser bundle (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here

# Base URL for the FastAPI backend. Default points at the local dev
# server started by ``pnpm dev:api``.
NEXT_PUBLIC_API_URL=http://localhost:8000
