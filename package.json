{
  "name": "claimguard",
  "version": "0.1.0",
  "description": "ClaimGuard – HCVO Health-Claim-Prüfung für den DACH-Raum",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @claimguard/web dev",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --reload --port 8000",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @claimguard/web test:e2e",
    "test:all": "turbo run test && pnpm test:e2e",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  }
}
