# ClaimGuard Caddy configuration.
#
# One canonical domain, two routes:
#   * /api/*   -> FastAPI backend (Sonnet pipeline, retrieval, etc.)
#   * /*       -> Next.js frontend (marketing site at /, app at /app)
#
# Caddy automatically provisions Let's-Encrypt certs for every host
# listed below and renews them; no manual ACME / certbot work required.
#
# DOMAIN is templated from the docker-compose env so we don't bake the
# canonical value into the repo. The www-redirect block sits next to it
# so visitors landing on www.claim-guard.de get bounced to the bare host
# with a 301 - standard SEO practice, avoids cookie/duplicate-content
# split-brain.

# Bare-domain canonical host.
{$DOMAIN} {
	encode zstd gzip

	# Reasonable security headers for an inhouse tool. Tighten if the
	# tool ever leaves the org.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Frontend bundles ship an inline service-worker manifest etc.;
		# the strict CSP we'd want here would need a dedicated review.
		# For now we keep CSP off and revisit during the public launch
		# (PROJ-17).
	}

	# Backend routes. Caddy keeps the trailing path so /api/analyses
	# becomes /api/analyses on the upstream.
	@api path /api/*
	handle @api {
		reverse_proxy api:8000 {
			# Long-running LLM calls; default 60 s timeouts choke our
			# evaluation + smart-apply requests on big pillar pages.
			# Opus-4.7-based final-audit on a 30k-char pillar page can
			# legitimately run 4-6 minutes, so we go to 10 min here.
			# FastAPI itself enforces a tighter 480 s per-request cap
			# (with a clean 503 fallback) before this kicks in.
			transport http {
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	# Everything else hits the Next.js standalone server.
	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
		level INFO
	}
}

# www-Subdomain: 301 to the canonical bare host. Caddy still has to
# obtain a cert for www.{domain} so the redirect can serve over HTTPS;
# point a CNAME or A record at the VPS for www, otherwise this block
# stays inert (no harm, Caddy just skips it).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
