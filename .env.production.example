# ClaimGuard production env
# Copy to .env.production and fill the blanks. Never commit the filled
# version - .gitignore covers it.

# =====================================================================
# Public
# =====================================================================

# The domain Caddy serves. Must point at the VPS public IP via DNS A
# record. Caddy provisions a Let's-Encrypt cert for it on first start.
DOMAIN=claimguard.example.de

# =====================================================================
# Anthropic
# =====================================================================

ANTHROPIC_API_KEY=

# Default models. Sonnet for everything is the cost-optimised setting
# from ADR-0007. Override with claude-opus-4-7 for evaluation only if
# the tool ever underperforms on judgement-heavy claims.
ANTHROPIC_MODEL_DETECTION=claude-sonnet-4-6
ANTHROPIC_MODEL_EVALUATION=claude-sonnet-4-6

# =====================================================================
# Embedding model (in-process via sentence-transformers, ADR-0006)
# =====================================================================

EMBEDDING_MODEL=intfloat/multilingual-e5-base

# =====================================================================
# Postgres
# =====================================================================
# Generate strong values before going live - the defaults below are fine
# for the first deploy but should be rotated.

POSTGRES_USER=claimguard
POSTGRES_PASSWORD=claimguard
POSTGRES_DB=claimguard
